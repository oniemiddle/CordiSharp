<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CordiSharp.Extensions.Logging</PackageId>
    <AssemblyName>CordiSharp.Extensions.Logging</AssemblyName>
    <RootNamespace>CordiSharp.Extensions.Logging</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>CordiSharp.Extensions.Logging</Title>
    <Description>Microsoft.Extensions.Logging integration for CordiSharp: exposes CordiSharp's LoggerService as a standard ILoggerProvider (AddCordiSharpLogging) and bridges CordiSharp log messages into the Microsoft.Extensions.Logging pipeline (CordiSharpLogExporter / UseLoggerFactory).</Description>
    <PackageTags>cordis;plugin;logging;logger;mel;framework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CordiSharp\CordiSharp.csproj" />
    <ProjectReference Include="..\CordiSharp.Extensions.DependencyInjection\CordiSharp.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
