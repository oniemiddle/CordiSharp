<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CordiSharp.Extensions.DependencyInjection</PackageId>
    <AssemblyName>CordiSharp.Extensions.DependencyInjection</AssemblyName>
    <RootNamespace>CordiSharp.Extensions.DependencyInjection</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>CordiSharp.Extensions.DependencyInjection</Title>
    <Description>Microsoft.Extensions.DependencyInjection integration for CordiSharp: registers a root Context singleton, CordiSharpOptions and MSDI-backed service resolution for plugins.</Description>
    <PackageTags>cordis;plugin;dependency-injection;di;context;framework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CordiSharp\CordiSharp.csproj" />
  </ItemGroup>

</Project>
