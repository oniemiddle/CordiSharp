<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CordiSharp.Extensions.Hosting</PackageId>
    <AssemblyName>CordiSharp.Extensions.Hosting</AssemblyName>
    <RootNamespace>CordiSharp.Extensions.Hosting</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>CordiSharp.Extensions.Hosting</Title>
    <Description>Microsoft.Extensions.Hosting integration for CordiSharp: a CordiSharpHost IHostedService that loads configured plugins when the host starts and unloads them when it stops.</Description>
    <PackageTags>cordis;plugin;hosting;lifecycle;host;framework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CordiSharp.Extensions.Logging\CordiSharp.Extensions.Logging.csproj" />
    <ProjectReference Include="..\CordiSharp\CordiSharp.csproj" />
    <ProjectReference Include="..\CordiSharp.Extensions.DependencyInjection\CordiSharp.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
